.venv/
Base/.venv/
venv/
env/
Base/ConsoleLogs/
Base/PositionLogs/
Base/Videos/
__pycache__/
*.py[cod]
*.egg-info/
.dist-info/
.idea/

# De .vscode se versiona lo portable (tareas, lanzadores, ajustes) y se ignora
# lo que describe ESTA maquina: c_cpp_properties.json lleva rutas absolutas al
# core ESP32 y lo regenera Controller/AttaBot/vscode_setup.py.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json

.DS_Store
Thumbs.db
.env

# Arduino build artifacts (regenerados en cada compilación)
build/

# Logs experimentales (los datos quedan en disco, no se versionan)
Logs/
Base/Logs/

# Figuras de salida de la simulación (se regeneran al correr la sim)
sim_output_*.png
Base/markers_svg/

# Figuras que deja analyze_logs.py --plot (se regeneran desde los logs).
# Sin anclar a Base/: también caen dentro de las carpetas de campaña
# (Base/simulacion_31-07/, etc.), donde los CSV sí se versionan y las figuras no.
congreg_*.png

# Videos de la campana de simulacion: 1.8GB, no van al repo
Base/simulacion_31-07/Videos/

# Copia del dataset que armo el usuario para compartir (incluye videos)
Base/analisis_30-07/data/
Base/analisis_30-07.zip

# Salida de arduino-cli (el .bin se regenera con: python3 OTA.py --build)
Controller/AttaBot/build/

# Salida de analyze_logs.py --campaign (se regenera desde el manifiesto)
Base/campana_runs.csv
Base/campana_robots.csv
