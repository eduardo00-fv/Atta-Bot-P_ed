@INPROCEEDINGS{Atta-Bot,
  author={Solis-Ortega, Rebeca and Calderón-Arce, Cindy and Brenes-Torres, Juan Carlos},
  booktitle={2024 IEEE 42nd Central America and Panama Convention (CONCAPAN XLII)}, 
  title={Atta-Bot: A Do-It-Yourself approach for swarm robotics}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Swarm robotics research often relies on simulated environments to test algorithms and understand cooperative behaviors. The "reality gap"—the disparity between simulations and real-world conditions—highlights the necessity of using physical robots to validate swarm behaviors. This paper introduces Atta-Bot, a cost-effective and DIY-friendly robot manufactured from common components, designed to bridge this gap. The performance of Atta-Bot in swarm exploration is evaluated using a random walk algorithm, considering variables such as movement distance, initial positions, robot quantity, and execution time. Atta-Bots use this algorithm to explore, detect obstacles, and relay information to a central server, ensuring data accuracy through verification with computer vision. The results show that greater coverage is achieved with increased execution time and a larger number of robots, especially when starting from the corners of the scenario. The Atta-Bot performs effectively in swarm exploration and adapts well to various environments. Validation with computer vision confirms the reliability of the data, affirming the functionality of the prototype.},
  keywords={Legged locomotion;Bridges;Computer vision;Accuracy;Swarm robotics;Prototypes;Servers;Reliability;Relays;Robot prototype;swarm robotics;DIY robot},
  doi={10.1109/CONCAPAN63470.2024.10933860},
  ISSN={2687-7244},
  month={Nov},
}


@article{Brenes-Torres_2025,
doi = {10.1088/1748-3190/ad8d28},
url = {https://dx.doi.org/10.1088/1748-3190/ad8d28},
year = {2024},
month = {nov},
publisher = {IOP Publishing},
volume = {20},
number = {1},
pages = {016004},
author = {Brenes-Torres, Juan Carlos and Calderón-Arce, Cindy and Blanes, Francisco and Simo, José},
title = {Bioinspired cooperation in a heterogeneous robot swarm using ferrofluid artificial pheromones for uncontrolled environments},
journal = {Bioinspiration \& Biomimetics},
abstract = {This article presents a novel bioinspired technology for the cooperation and coordination of heterogeneous robot swarms in uncontrolled environments, utilizing an artificial pheromone composed of magnetized ferrofluids. Communication between different types of robots is achieved indirectly through stigmergy, where messages are inherently associated with specific locations. This approach is advantageous for swarm experimentation outside controlled laboratory spaces, where localization is typically managed through centralized camera systems (e.g. infrared, RGB). Applying pheromone principles has also proven beneficial for various swarm behaviors. We introduce a detection methodology for the artificial ferrofluid pheromone using low-cost magnetic sensors, along with signal processing and parameter characterization. Experiments involved a heterogeneous swarm consisting of two types of robots: one equipped with camera and image processing capabilities and the other with basic sensor technologies. Validation in multiple uncontrolled environments (with varying floor surfaces, wind, and light conditions) demonstrated successful cooperation among robots with differing technological complexities using the proposed technology.}
}

